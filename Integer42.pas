// Integer42
// Дано ціну товару P і N гривень у гаманці (N > P).
// Знайти, скільки товарів можна купити і скільки грошей залишиться?

begin
  var P := ReadInteger('Ціна товару P (грн) = ');
  var N := ReadInteger('Грошей у гаманці N (грн) = ');
  Writeln('Можна купити товарів: ', N div P);
  Writeln('Залишиться грошей: ', N mod P, ' грн');
end.
